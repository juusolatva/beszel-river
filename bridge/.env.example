# Copy to bridge/.env. Variables are described in docs/PLAN.md "Bridge configuration".

# Beszel hub as reached from the bridge (same host or Docker network), not the public URL.
BESZEL_URL=http://127.0.0.1:8090
# Dedicated non-admin Beszel user. It must be in each system's users list
# unless the hub runs with SHARE_ALL_SYSTEMS=true.
BESZEL_EMAIL=
BESZEL_PASSWORD=

# Data source adapter: "systems" (60 s updates) or "realtime" (1 s updates, milestone M6).
SOURCE=systems

# Listen address; nginx proxies /stream here.
BIND_HOST=127.0.0.1
BIND_PORT=8787

# Secret for deriving opaque stream IDs and the daily band order. Any long random string.
STREAM_SALT=
