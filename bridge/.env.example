# Copy to bridge/.env. Variables are described in docs/PLAN.md "Bridge configuration".

# Beszel hub as reached from the bridge (same host or Docker network), not the public URL.
# With deploy/compose.yml: http://<hub service>:8090, e.g. http://beszel:8090.
BESZEL_URL=http://127.0.0.1:8090
# Dedicated Beszel user with the "readonly" role. It must be in each system's users list
# unless the hub runs with SHARE_ALL_SYSTEMS=true.
BESZEL_EMAIL=
BESZEL_PASSWORD=
# Instead of the two above, when the hub has password auth disabled (OIDC only): an impersonation
# token for that user, from the hub's PocketBase dashboard (README, "Bridge setup").
BESZEL_TOKEN=

# Data source adapter: "systems" (60 s updates) or "realtime" (1 s updates while someone watches the
# page; the hub then polls every up agent once a second, and stops 30 s after the last viewer leaves).
SOURCE=systems

# Listen address; nginx proxies /stream here. deploy/compose.yml overrides both inside the container.
BIND_HOST=127.0.0.1
BIND_PORT=8787

# Secret for deriving opaque stream IDs and the daily band order. At least 16 characters,
# e.g. the output of: openssl rand -hex 32
STREAM_SALT=

# Mixing weights; falls back to mix.example.json when the file is missing.
MIX_FILE=mix.json
