# Copy to .env next to compose.yml (deploy/.env in a checkout), fill in, then: chmod 600 .env
# Variables are described in docs/PLAN.md "Bridge configuration". compose.yml fixes the listen address,
# ports, STATIC_DIR, HEALTH_PORT and MIX_FILE inside the container. For running the bridge without
# Docker, use bridge/.env.example instead.
#
# Quoting: Docker Compose replaces $name and ${name} in unquoted and double-quoted values, usually with
# nothing. Single-quoted values are taken literally, so keep every secret in single quotes:
#   STREAM_SALT='CHANGE$ME'   (without the quotes, Compose would read CHANGE)
# The systemd setup reads bridge/.env without this substitution, so a value copied from there may need
# the quotes added.

# Beszel hub as reached from the container, not its public URL. Use the line for your setup:
# 1. On another machine, or a published port: its address.
#BESZEL_URL=http://192.168.1.10:8090
# 2. In Docker on this host: the hub's service name, with compose.beszel-network.yml (COMPOSE_FILE below).
#BESZEL_URL=http://beszel:8090
# 3. On this host (native or network_mode: host), listening beyond loopback. The host firewall must
#    allow connections from Docker's bridge network.
#BESZEL_URL=http://host.docker.internal:8090
# 4. On this host, listening only on 127.0.0.1: with compose.host-network.yml (COMPOSE_FILE below).
#BESZEL_URL=http://127.0.0.1:8090

# Dedicated Beszel user with the "readonly" role. It must be in each system's users list unless the
# hub runs with SHARE_ALL_SYSTEMS=true.
BESZEL_EMAIL=''
BESZEL_PASSWORD=''
# Instead of the two above, when the hub has password auth disabled (OIDC only): an impersonation
# token for that user (README, "Bridge setup").
BESZEL_TOKEN=''

# Secret for deriving opaque stream IDs, band order and widths. At least 16 characters,
# e.g. the output of: openssl rand -hex 32
STREAM_SALT=''

# Data source adapter: "systems" (60 s updates) or "realtime" (1 s updates while someone watches the
# page; the hub then polls every up agent once a second, and stops 30 s after the last viewer leaves).
SOURCE=systems

# Compose settings. They also reach the container, which ignores them.
# Override files to use with a plain `docker compose` in this directory (case 2 or 4 above):
#COMPOSE_FILE=compose.yml:compose.beszel-network.yml
#COMPOSE_FILE=compose.yml:compose.host-network.yml
# Case 2: the hub's Docker network (default beszel_default, the network of a Compose project in a
# directory named beszel).
#BESZEL_NETWORK=beszel_default
# Host port for the page, on 127.0.0.1.
#RIVER_PORT=8095
# Case 4 only: host port for the health check, on 127.0.0.1.
#RIVER_HEALTH_PORT=8788
